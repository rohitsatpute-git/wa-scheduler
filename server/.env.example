PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Matches docker-compose.yml at the repo root
DATABASE_URL=postgres://wa:wa@localhost:5433/wa_scheduler

# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# 64 hex chars (32 bytes). Encrypts WhatsApp credentials at rest. Changing it invalidates every linked session.
SESSION_ENC_KEY=

# Sending limits (ban-risk mitigation)
MAX_RECIPIENTS=50
SEND_GAP_MIN_MS=2000
SEND_GAP_MAX_MS=6000

# Scheduler: messages sent at once (max one per user), and how often to check for due messages
SEND_CONCURRENCY=20
POLL_INTERVAL_MS=5000
