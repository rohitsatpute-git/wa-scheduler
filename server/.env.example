PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Matches docker-compose.yml at the repo root
DATABASE_URL=postgres://wa:wa@localhost:5433/wa_scheduler

# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# 64 hex chars (32 bytes). Encrypts WhatsApp credentials at rest. Changing it invalidates every linked session.
SESSION_ENC_KEY=

# Sending limits (ban-risk mitigation)
MAX_RECIPIENTS=50
SEND_GAP_MIN_MS=2000
SEND_GAP_MAX_MS=6000

# Scheduler: messages sent at once (max one per user), and how often to check for due messages
SEND_CONCURRENCY=20
POLL_INTERVAL_MS=5000

# AI auto-reply (optional). Set one key; without any key the feature is hidden.
# If several are set, AI_PROVIDER picks (anthropic | openai | gemini); otherwise Anthropic, then OpenAI, then Gemini.
# Gemini has a free tier: create a key at https://aistudio.google.com/apikey (no card needed).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_PROVIDER=
# Defaults: claude-opus-5-5 (Anthropic), gpt-6-luna (OpenAI), gemini-3.5-flash-lite (Gemini)
AI_MODEL=

# Android app WebView origins allowed to call the API (bearer token, no cookies).
APP_ORIGINS=https://localhost,capacitor://localhost
# Contact shown on the /privacy page.
CONTACT_EMAIL=
